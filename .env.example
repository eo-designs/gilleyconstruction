# --- Cloudflare R2 (server-side, used by upload script) ---
# Find these in Cloudflare Dashboard → R2 → "Manage R2 API Tokens" → Create API token
# Permissions: "Object Read & Write" scoped to your bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: override the S3 endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=

# --- Public URL used by the app at runtime ---
# Either:
#   1. Enable "Public access" on your R2 bucket (Settings → Public access → r2.dev subdomain)
#      → looks like: https://pub-XXXXXXXX.r2.dev
#   2. Connect a custom domain in R2 settings
#      → looks like: https://media.gilleyconstruction.com
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Optional: only needed if you set a custom domain so next.config can whitelist it for next/image
# NEXT_PUBLIC_R2_PUBLIC_HOSTNAME=media.gilleyconstruction.com

# --- Toggle: when to use R2 vs local public/ ---
# "true"  → always use R2 (use this on Vercel prod env)
# "false" → always use local /public (default for dev)
# unset   → auto: use R2 when VERCEL_ENV === "production"
NEXT_PUBLIC_USE_R2=false
